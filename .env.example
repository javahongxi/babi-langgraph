# Babi Agent Environment Configuration
# Copy this file to .env and fill in your values

# Required: DashScope API Key
# Get your API key from: https://dashscope.aliyun.com
# Set via environment variable: export DASHSCOPE_API_KEY=your_key
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: Tavily Search API Key (for Web search tool, free tier: 1000 calls/month)
# Get your API key from: https://tavily.com
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional: GitHub Token (for GitHub API tool)
# Get your token from: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_token_here

# Optional: Model configuration
# BABI_MODEL_NAME=qwen3.7-plus

# Optional: Workspace directory
# BABI_WORKSPACE=~/babi-langgraph-workspace

# Optional: Server configuration
# BABI_HOST=127.0.0.1
# BABI_PORT=8900

# Optional: PostgreSQL connection for session persistence
# Local trust auth (no password needed):
# BABI_PG_DSN=postgresql://user@localhost:5432/babi
# Or with password (if you configure md5/scram auth):
# BABI_PG_DSN=postgresql://user:password@localhost:5432/babi
